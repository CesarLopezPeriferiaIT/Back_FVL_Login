# Ambiente de ejecucion del servicio. Define el prefijo de rutas /backend/{ambiente}/v{version}.
# Valores permitidos: dev, qas, prd.
APP_ENV=dev

# Version mayor de la API. Se usa en el prefijo /backend/{ambiente}/v{version}.
API_VERSION=1

# Puerto TCP donde escucha el servicio.
PORT=3000

# URL publica del servicio. Se usa para construir los enlaces de confirmacion de correo y de
# reseteo de contrasena que se envian por correo.
PUBLIC_BASE_URL=http://localhost:3000

# Version de los terminos y condiciones aceptados durante el registro.
TYC_VERSION=1.0.0

# Secreto de firma de los tokens de acceso (JWT).
JWT_ACCESS_SECRET=cambie-este-valor-por-un-secreto-de-al-menos-32-caracteres

# Vida util del token de acceso, en notacion de jsonwebtoken (15m, 1h, 30s).
JWT_ACCESS_TTL=15m

# Secreto de firma de los tokens de confirmacion de correo (JWT).
JWT_CONFIRM_SECRET=cambie-este-valor-por-un-secreto-de-al-menos-32-caracteres

# Vida util del token de confirmacion de correo.
JWT_CONFIRM_TTL=24h

# Secreto de firma de los tokens de reseteo de contrasena (JWT).
JWT_RESET_SECRET=cambie-este-valor-por-un-secreto-de-al-menos-32-caracteres

# Vida util del token de reseteo de contrasena.
JWT_RESET_TTL=30m

# Emisor (iss) de los tokens emitidos por este servicio.
JWT_ISSUER=fvl-login

# Audiencia (aud) de los tokens emitidos por este servicio.
JWT_AUDIENCE=fvl-clients

# Vida util del refresh token, en dias. Cada renovacion extiende la vigencia de la sesion.
REFRESH_TOKEN_TTL_DAYS=30

# Servidor de base de datos SQL Server. Instancia desplegada de AWS RDS.
DB_SERVER=hpp-dev-sql.cul4syiguuqq.us-east-1.rds.amazonaws.com

# Puerto del servidor SQL Server.
DB_PORT=1433

# Nombre de la base de datos.
DB_DATABASE=FVL_Login

# Usuario de la base de datos. Debe ser el rol propio de la aplicacion, nunca el administrador.
DB_USER=cambie-este-usuario-de-la-rds

# Contrasena del rol de la aplicacion en SQL Server.
DB_PASSWORD=cambie-esta-contrasena

# Cifrado TLS de la conexion con SQL Server. La RDS cifra el trafico con su propio certificado.
DB_ENCRYPT=true

# No se valida el certificado del servidor porque no se entrega la cadena de la AWS RDS CA.
# El trafico sigue cifrado; lo que no se comprueba es la identidad del servidor.
DB_TRUST_SERVER_CERTIFICATE=true

# Numero maximo de conexiones simultaneas del pool.
DB_POOL_MAX=10

# Tiempo maximo de espera para obtener una conexion del pool, en milisegundos.
DB_POOL_CONNECT_TIMEOUT=15000

# Origenes permitidos por CORS, separados por coma. Nunca use el asterisco.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Prefijos de red (CIDR) de los proxies reversos confiables. Nunca use trust proxy=true.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Intentos de autenticacion permitidos por identificador (correo) dentro de la ventana de rate limit.
RATE_LIMIT_LOGIN_PER_IDENTIFIER=10

# Intentos de autenticacion permitidos por direccion IP dentro de la ventana de rate limit.
RATE_LIMIT_LOGIN_PER_IP=50

# Duracion de la ventana de rate limit, en minutos.
RATE_LIMIT_WINDOW_MINUTES=15

# Registros de cuenta permitidos por direccion IP dentro de la ventana de rate limit.
RATE_LIMIT_REGISTER_PER_IP=20

# Servidor SMTP usado para enviar el correo de confirmacion y el de reseteo de contrasena.
SMTP_HOST=smtp.example.org

# Puerto del servidor SMTP.
SMTP_PORT=587

# Uso de TLS implicito en la conexion SMTP.
SMTP_SECURE=false

# Usuario de autenticacion en el servidor SMTP.
SMTP_USER=

# Contrasena del usuario SMTP.
SMTP_PASSWORD=

# Remitente por defecto de los correos enviados por el servicio.
MAIL_FROM=no-reply@fvl.org.co

# Transporte de correo: smtp usa el servidor configurado; console imprime el mensaje en el log.
# En desarrollo cae automaticamente a console si no hay SMTP_HOST configurado.
MAIL_TRANSPORT=smtp

# Nivel de detalle de los logs: debug, info, warn o error.
LOG_LEVEL=info
